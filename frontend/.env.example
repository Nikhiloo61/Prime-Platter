# ===================================================================
# Prime Platter - Frontend Environment Configuration (.env)
# ===================================================================

# Base URL of the deployed Express Backend API on Vercel
# Example: https://prime-platter-api.vercel.app or http://localhost:5001
VITE_API_URL=https://your-backend-api.vercel.app

# Optional: WebSocket / Socket.IO Server Endpoint
# If omitted, automatically derived from VITE_API_URL
VITE_SOCKET_URL=https://your-backend-api.vercel.app

# Razorpay Key ID for client-side Checkout Modal (Test Mode)
# Example: rzp_test_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
