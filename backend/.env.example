# ==============================================================
# Prime Platter - Full-Stack Food Delivery Platform Environment
# ==============================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database URI (MongoDB Atlas or Local replica)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_delivery_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/food_delivery_db

# JSON Web Token (JWT) Security Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test Mode Credentials)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# AI Food Assistant (Optional - Fallback active when omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Map & Geolocation Platform (Optional - SVG/Canvas active when omitted)
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
